{
  "name": "street-bump-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:dev": "env-cmd -f .env.development next build",
    "build:v1": "env-cmd -f .env.development next build && node -e \"require('fs').cpSync('out','out-v1',{recursive:true,force:true})\"",
